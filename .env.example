# Database
DATABASE_URL=postgresql://phishing_user:phishing_pass@postgres:5432/phishing_guard

# Application
DEBUG=false
API_KEYS=

# VirusTotal API keys — one per VT account, comma-separated.
# Multiple keys enable automatic rotation: when one account hits its daily
# quota (429) the next key is used until the metering period resets.
# VIRUSTOTAL_API_KEYS=key1,key2,key3
VIRUSTOTAL_API_KEYS=

# Email IMAP
EMAIL_HOST=imap.gmail.com
EMAIL_PORT=993
EMAIL_ADDRESS=your-email@gmail.com
EMAIL_PASSWORD=your-app-password

# Paths
ATTACHMENT_DIR=/app/uploads
MODEL_PATH=/app/data/phishing_model.joblib

# Attachment engine
MAX_ATTACHMENT_BYTES=52428800
# Attachment SHA-256 reputation lookups on VirusTotal (no file upload).
# Requires VIRUSTOTAL_API_KEYS; safe to enable — lookups rotate across keys.
ENABLE_VT_HASH_LOOKUP=false

# Dynamic URL analysis: opt in only after Chromium is installed
DYNAMIC_URL_ENABLED=false
DYNAMIC_URL_NAVIGATION_TIMEOUT_SECONDS=12
DYNAMIC_URL_TOTAL_TIMEOUT_SECONDS=20
DYNAMIC_URL_SCAN_BUDGET_SECONDS=45
DYNAMIC_URL_MAX_PER_SCAN=3
DYNAMIC_URL_MAX_REDIRECTS=8
DYNAMIC_URL_RENDER_DELAY_MS=1500
DYNAMIC_URL_ALLOWED_PORTS=80,443
DYNAMIC_URL_SCREENSHOT_DIR=/app/uploads/url_screenshots
DYNAMIC_URL_SCREENSHOT_RETENTION_DAYS=14

# ── Week 1: header forensics / raw evidence ─────────────────
# Gzip raw RFC822 retained next to attachments (sha256 over original bytes)
PRESERVE_RAW_EMAIL=true
# Overridable raw-email directory (default: <ATTACHMENT_DIR>/raw_emails)
RAW_EMAIL_DIR=
# Active DNS validation of SPF/DMARC/DKIM (needs dnspython + network)
HEADER_DNS_CHECKS_ENABLED=false

# ── Week 2: origin / geo / reputation intel ────────────────
# ipwhois (free API, default) | maxmind (offline GeoLite2) | none
GEOIP_PROVIDER=ipwhois
MAXMIND_DB_PATH=
IP_INTEL_CACHE_DAYS=30
DNSBL_ENABLED=false
DNSBL_ZONES=bl.spamcop.net

# ── Reports / retention ────────────────────────────────────
MASK_PII=false
RETENTION_DAYS=90

# Domain intel lookups (GET /domains/{domain}/intel + young-domain attribution)
DOMAIN_INTEL_DNS_ENABLED=false
DOMAIN_INTEL_RDAP_ENABLED=false
