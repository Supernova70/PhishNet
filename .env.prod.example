# =============================================================================
#  Phishing Guard V2 — Production Environment Template
# =============================================================================
#  Copy this file to .env.prod on the EC2 instance and fill in your values:
#    cp .env.prod.example .env.prod
#    nano .env.prod
# =============================================================================

# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://phishing_user:CHANGE_ME@postgres:5432/phishing_guard
DB_PASSWORD=CHANGE_ME

# ── App Settings ─────────────────────────────────────────────────────────────
DEBUG=false

# ── VirusTotal API (Optional) ────────────────────────────────────────────────
# Free tier: 4 requests/minute, 500 requests/day PER ACCOUNT.
# Add one key per VT account, comma-separated — keys rotate automatically:
# a key that returns 429 (daily quota) goes into cooldown and the next key
# is used; invalid keys (401) are skipped.
# VIRUSTOTAL_API_KEYS=key1,key2,key3
# Leave empty for heuristic-only mode (no VT lookups):
VIRUSTOTAL_API_KEYS=

# ── Email IMAP ───────────────────────────────────────────────────────────────
EMAIL_HOST=imap.gmail.com
EMAIL_PORT=993
EMAIL_ADDRESS=your-email@gmail.com
EMAIL_PASSWORD=your-gmail-app-password

# ── File Paths ───────────────────────────────────────────────────────────────
ATTACHMENT_DIR=/app/uploads
MODEL_PATH=/app/data/phishing_model.joblib

# ── Limits ───────────────────────────────────────────────────────────────────
MAX_ATTACHMENT_BYTES=52428800
# Attachment SHA-256 reputation (file hash only — never uploads content):
ENABLE_VT_HASH_LOOKUP=true
AUTO_SCAN_ENABLED=false
SCAN_THRESHOLD=50

# ── Google sign-in (Sign in with Google + Gmail consent) ──────────────
# One-time setup: docs/MULTI_TENANT_PLAN.md P0 (Google Cloud Console).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must exactly match an Authorized redirect URI in the OAuth client:
GOOGLE_REDIRECT_URI=http://localhost:5173/api/auth/callback
# Our own session cookie (HS256) — long random value in production:
SESSION_SECRET=change-me-to-a-long-random-string
SESSION_TTL_HOURS=168
SESSION_COOKIE_SECURE=false   # true behind HTTPS
# Fernet key for secrets at rest (refresh tokens, email bodies):
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=
# Comma-separated Google emails granted admin role (metadata-only admin views):
ADMIN_EMAILS=
