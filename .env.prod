# =============================================================================
#  Phishing Guard V2 — Production Environment
# =============================================================================
#  Copy this to .env.prod on the EC2 instance and fill in your values.
# =============================================================================

# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://phishing_user:${DB_PASSWORD}@postgres:5432/phishing_guard
DB_PASSWORD=CHANGE_ME_TO_A_STRONG_PASSWORD

# ── App Settings ─────────────────────────────────────────────────────────────
DEBUG=false

# ── VirusTotal API (Optional) ────────────────────────────────────────────────
# Free tier: 4 requests/minute, 500 requests/day
# Leave empty for heuristic-only mode (no VT lookups):
VIRUSTOTAL_API_KEYS=

# ── Email IMAP ───────────────────────────────────────────────────────────────
EMAIL_HOST=imap.gmail.com
EMAIL_PORT=993
EMAIL_ADDRESS=your-email@gsfcuniversity.ac.in
EMAIL_PASSWORD=your-app-password

# ── File Paths ───────────────────────────────────────────────────────────────
ATTACHMENT_DIR=/app/uploads
MODEL_PATH=/app/data/phishing_model.joblib

# ── Limits ───────────────────────────────────────────────────────────────────
MAX_ATTACHMENT_BYTES=52428800
ENABLE_VT_HASH_LOOKUP=false
AUTO_SCAN_ENABLED=false
SCAN_THRESHOLD=50
